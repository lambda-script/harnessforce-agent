{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"//#lint:root": {
			"env": [
				"METRICS_FILE",
				"PREVIOUS_METRICS_FILE",
				"DRY_RUN",
				"HF_EVAL_CALL_LOG"
			]
		},
		"//#knip": {
			"cache": false
		},
		"//#typecheck:root": {},
		"//#test:root": {
			"cache": false
		}
	}
}
