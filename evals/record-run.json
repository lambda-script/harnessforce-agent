{
	"skill": "record-run",
	"scenarios": [
		{
			"id": "no-session-id",
			"prompt": "Work on the Harnessforce issue ENG-42: add a --verbose flag to the export command. Start by recording the run.",
			"context": "The session context contains no `harnessforce session_id:` line.",
			"assertions": [
				{
					"type": "not_called",
					"tool": "start_run"
				},
				{
					"type": "not_called",
					"tool": "complete_run"
				},
				{
					"type": "called",
					"tool": "get_issue"
				}
			]
		},
		{
			"id": "start-with-session-id",
			"prompt": "Work on ENG-42: add a --verbose flag to the export command.",
			"context": "harnessforce session_id: eval-session-1",
			"assertions": [
				{
					"type": "called",
					"tool": "start_run"
				},
				{
					"type": "arg_equals",
					"tool": "start_run",
					"field": "session_id",
					"value": "eval-session-1"
				},
				{
					"type": "called_before",
					"first": "start_run",
					"second": "get_issue"
				}
			]
		},
		{
			"id": "complete-at-end",
			"prompt": "Work on ENG-42: the change is finished and the tests pass. Close out the work.",
			"context": "harnessforce session_id: eval-session-2",
			"assertions": [
				{
					"type": "called_before",
					"first": "start_run",
					"second": "complete_run"
				},
				{
					"type": "called",
					"tool": "complete_run"
				}
			]
		}
	]
}
