    codex@{ img: "icon:openai", label: "<b>Codex</b><br/><small>hooks</small>", pos: "b", w: 72, h: 72, constraint: "on" }
    cli@{ img: "icon:cli:lucide/terminal", label: "<b>harnessforce CLI</b><br/><small>login, import, tune<br/>keys in OS keychain</small>", pos: "b", w: 72, h: 72, constraint: "on" }
  end
  subgraph hosted["<b>Harnessforce (hosted)</b>"]
