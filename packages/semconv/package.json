{
	"name": "@harnessforce/semconv",
	"version": "0.1.0",
	"description": "Harnessforce semantic conventions: hf.* attributes and ingest JSON Schemas",
	"keywords": [
		"harnessforce",
		"opentelemetry",
		"semantic-conventions",
		"json-schema",
		"typebox"
	],
	"license": "Apache-2.0",
	"homepage": "https://github.com/lambda-script/harnessforce-agent/tree/main/packages/semconv#readme",
	"bugs": {
		"url": "https://github.com/lambda-script/harnessforce-agent/issues"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lambda-script/harnessforce-agent.git",
		"directory": "packages/semconv"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"build": "tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.52"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@harnessforce/test-support": "workspace:*",
		"@types/node": "^22.20.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
