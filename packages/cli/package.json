{
	"name": "@harnessforce/cli",
	"version": "0.1.0",
	"description": "Harnessforce command line (harnessforce)",
	"keywords": [
		"harnessforce",
		"claude-code",
		"opentelemetry",
		"ai-agents",
		"cli"
	],
	"license": "Apache-2.0",
	"homepage": "https://github.com/lambda-script/harnessforce-agent/tree/main/packages/cli#readme",
	"bugs": {
		"url": "https://github.com/lambda-script/harnessforce-agent/issues"
	},
	"type": "module",
	"bin": {
		"harnessforce": "./dist/bin.js",
		"hf": "./dist/bin.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lambda-script/harnessforce-agent.git",
		"directory": "packages/cli"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"build": "tsdown && node scripts/build-config.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@decimalturn/toml-patch": "3.3.0",
		"@harnessforce/agent-core": "workspace:*",
		"@harnessforce/test-support": "workspace:*",
		"@types/node": "^22.20.4",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@harnessforce/semconv": "workspace:*",
		"@napi-rs/keyring": "^2.1.0"
	}
}
