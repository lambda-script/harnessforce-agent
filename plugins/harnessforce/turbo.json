{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"test": {
			"dependsOn": ["^build", "build"]
		},
		"build": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/.claude-plugin/marketplace.json",
				"$TURBO_ROOT$/LICENSE"
			],
			"outputs": ["dist/**"]
		}
	}
}
