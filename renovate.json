{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":semanticCommits",
		"helpers:pinGitHubActionDigests",
		"group:allNonMajor"
	],
	"packageRules": [
		{
			"description": "The node18-runtime job pins Node.js 18 on purpose: the plugin hook requires Node.js 18 or later",
			"matchManagers": ["github-actions"],
			"matchDepNames": ["node"],
			"enabled": false
		}
	],
	"customManagers": [
		{
			"description": "The CI validates the plugin with a pinned Claude Code run through npx",
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
			"matchStrings": [
				"npx --yes (?<depName>@anthropic-ai/claude-code)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
			],
			"datasourceTemplate": "npm"
		}
	]
}
