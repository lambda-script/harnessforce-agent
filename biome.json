{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {},
			"suspicious": {
				"noImportCycles": "error"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["plugins/harnessforce/src/entry.cjs"],
			"javascript": {
				"formatter": {
					"trailingCommas": "es5"
				}
			}
		},
		{
			"includes": ["packages/*/*", "plugins/*/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../**"],
										"message": "Import another workspace package by its package name, not by a relative path across package roots."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/*/*/*", "plugins/*/*/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../../**"],
										"message": "Import another workspace package by its package name, not by a relative path across package roots."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/*/*/*/*", "plugins/*/*/*/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../../../**"],
										"message": "Import another workspace package by its package name, not by a relative path across package roots."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/*/*/*/*/*", "plugins/*/*/*/*/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../../../../**"],
										"message": "Import another workspace package by its package name, not by a relative path across package roots."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/*/*/*/*/*/*", "plugins/*/*/*/*/*/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../../../../../**"],
										"message": "Import another workspace package by its package name, not by a relative path across package roots."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["tests/**", "scripts/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["../packages/**", "../plugins/**"],
										"message": "Import another workspace package by its package name, not by a relative path across package roots."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
