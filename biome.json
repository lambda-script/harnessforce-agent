{
	"$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!!**/dist"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["plugins/harnessforce/src/entry.cjs"],
			"javascript": {
				"formatter": {
					"trailingCommas": "es5"
				}
			}
		}
	]
}
